# ==============================================================================
# KINGSOK WORKFORCE SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development against STAGING.
# NEVER commit .env.local, .env.staging, or .env.production to version control.
#
# RULE: Staging and Live must be two isolated Supabase projects.
# All development, testing, and migration verification occur on STAGING only.
# Nothing touches LIVE until approved by Okoye.
# ==============================================================================

# Environment Identifier: strictly "staging" for development & testing
NEXT_PUBLIC_APP_ENV=staging

# Expected Staging Supabase Project Reference (e.g. "abcdefghijklmnopqrst")
# Used by the fail-closed environment guard in scripts/verify-task1a.ts
EXPECTED_STAGING_PROJECT_REF=your-staging-project-ref

# Supabase Project URL (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co

# Supabase Public Anon Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Used ONLY by backend verification scripts; NEVER in browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Direct PostgreSQL Connection URL (Used ONLY for migration and trigger tests on staging)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-staging-project-ref.supabase.co:5432/postgres
